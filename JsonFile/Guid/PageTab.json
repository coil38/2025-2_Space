[{"pageID":10001,"label":"\uC774\uB3D9 \uBC0F \uAE30\uBCF8 \uD589\uB3D9","description":"\uC804\uC7A5\uC758 \uAE30\uBCF8\uC740 \uC6C0\uC9C1\uC784\uC785\uB2C8\uB2E4.\n\n\uCE90\uB9AD\uD130\uB97C \uC790\uC720\uB86D\uAC8C \uC6C0\uC9C1\uC5EC \uC801\uC758 \uACF5\uACA9\uC744 \uD53C\uD558\uACE0 \uC720\uB9AC\uD55C \uC704\uCE58\uB97C \uC120\uC810\uD558\uC138\uC694.\n\uC801\uC744 \uB9C8\uC8FC\uCCE4\uB2E4\uBA74 \uC8FC\uC800\uD558\uC9C0 \uB9D0\uACE0 \uACF5\uACA9\uD558\uC5EC \uC81C\uC555\uD574\uC57C \uD569\uB2C8\uB2E4.\n\n- \uC774\uB3D9: W, A, S, D \uD0A4\uB85C \uC0C1\uD558\uC88C\uC6B0\uB85C \uC774\uB3D9\uD569\uB2C8\uB2E4.\n- \uAE30\uBCF8 \uACF5\uACA9: \uB9C8\uC6B0\uC2A4 \uC88C\uD074\uB9AD\uC73C\uB85C \uAE30\uBCF8\uC801\uC778 \uACF5\uACA9\uC744 \uAC00\uD569\uB2C8\uB2E4.\n- \uBCF4\uC870 \uACF5\uACA9: \uB9C8\uC6B0\uC2A4 \uC6B0\uD074\uB9AD\uC73C\uB85C \uBB34\uAE30\uC5D0 \uB530\uB978 \uD2B9\uC218 \uB3D9\uC791\uC744 \uC218\uD589\uD569\uB2C8\uB2E4.","spritePath":"Assets/Materials/image/Frame 102 (7).png"},{"pageID":10002,"label":"\uD2B9\uC218 \uD589\uB3D9","description":"\uC804\uD22C\uC758 \uD310\uB3C4\uB97C \uB4A4\uC9D1\uB294 \uAE30\uC220\uB4E4\uC785\uB2C8\uB2E4.\n\n\uC704\uAE30 \uC0C1\uD669\uC5D0\uC11C\uB294 \uD68C\uD53C\uB97C \uC0AC\uC6A9\uD558\uACE0, \uAC15\uB825\uD55C \uC2A4\uD0AC\uB85C \uC801\uB4E4\uC744 \uC77C\uB9DD\uD0C0\uC9C4\uD558\uC138\uC694.\n\uC8FC\uBCC0\uC758 \uC0AC\uBB3C\uC744 \uD65C\uC6A9\uD558\uB294 \uAC83\uB3C4 \uC0DD\uC874\uC758 \uC9C0\uD61C\uC785\uB2C8\uB2E4.\n\n- \uB300\uC2DC(\uD68C\uD53C): Space Bar\uB97C \uB20C\uB7EC \uBE60\uB974\uAC8C \uC774\uB3D9\uD569\uB2C8\uB2E4.\n- \uC2A4\uD0AC: Q, E, R \uD0A4\uB85C \uACE0\uC720\uD55C \uD2B9\uC218 \uAE30\uC220\uC744 \uC0AC\uC6A9\uD569\uB2C8\uB2E4.\n- \uC0C1\uD638\uC791\uC6A9 : F\uD0A4\uB85C \uC544\uC774\uD15C\uC744 \uC90D\uAC70\uB098 \uC7A5\uCE58\uB97C \uC870\uC791\uD558\uACE0 Z\uD0A4\uB97C \uB20C\uB7EC \uD504\uB85C\uC138\uC2A4\uC758 \uC0C1\uC138 \uC815\uBCF4\uB97C \uD655\uC778\uD569\uB2C8\uB2E4.","spritePath":"Assets/Materials/image/Frame 102 (6).png"},{"pageID":10003,"label":"\uC0C1\uD0DC \uC815\uBCF4","description":"\uB2F9\uC2E0\uC758 \uC0C1\uD0DC\uB97C \uC218\uC2DC\uB85C \uD655\uC778\uD558\uC2ED\uC2DC\uC624.\n\n\uC0DD\uC874\uC744 \uC704\uD574\uC11C\uB294 \uC790\uC2E0\uC758 \uC0C1\uD0DC\uB97C \uD30C\uC545\uD558\uB294 \uAC83\uC774 \uBB34\uC5C7\uBCF4\uB2E4 \uC911\uC694\uD569\uB2C8\uB2E4.\n\n1. \uCCB4\uB825 (HP): \uC0DD\uBA85\uC120\uC785\uB2C8\uB2E4. 0\uC774 \uB418\uBA74 \uC791\uC804\uC740 \uC2E4\uD328\uB85C \uB3CC\uC544\uAC11\uB2C8\uB2E4.\n2. \uACBD\uD5D8\uCE58 \uBC14: \uBAAC\uC2A4\uD130\uB97C \uCC98\uCE58\uD558\uBA74 \uCC28\uC624\uB985\uB2C8\uB2E4. \uAC00\uB4DD \uCC28\uBA74 \uB808\uBCA8\uC5C5\uC744 \uD1B5\uD574 \uB354 \uAC15\uD574\uC9C8 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n3. \uC624\uC5FC\uB3C4 \uAC8C\uC774\uC9C0: \uC720\uBB3C \uC7A5\uCC29\uC758 \uD55C\uACC4\uCE58\uC785\uB2C8\uB2E4. \uC774 \uAC8C\uC774\uC9C0\uB97C \uB118\uC5B4\uC11C\uB294 \uC720\uBB3C\uC740 \uC7A5\uCC29\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.","spritePath":"Assets/Materials/image/Frame 102 (5).png"},{"pageID":10004,"label":"\uC9C4\uC785\uACFC \uBD09\uC1C4","description":"\uC804\uD22C \uB8F8\uC5D0 \uBC1C\uC744 \uB4E4\uC774\uB294 \uC21C\uAC04, \uB4F1 \uB4A4\uC758 \uBB38\uC740 \uAD73\uAC8C \uB2EB\uD799\uB2C8\uB2E4. \uBD09\uC1C4\uB41C \uACF5\uAC04 \uC548\uC5D0\uC11C \uB2F9\uC2E0\uC744 \uB178\uB9AC\uB294 \uC801\uB4E4\uACFC \uB9C8\uC8FC\uD558\uAC8C \uB420 \uAC83\uC785\uB2C8\uB2E4.\n\n\uB3C4\uB9DD\uCE60 \uBC29\uBC95\uC740 \uC5C6\uC2B5\uB2C8\uB2E4. \uC624\uC9C1 \uB208\uC55E\uC758 \uC801\uB4E4\uC744 \uBAA8\uB450 \uC4F0\uB7EC\uB728\uB9AC\uACE0 \uC0B4\uC544\uB0A8\uB294 \uAC83\uB9CC\uC774 \uC720\uC77C\uD55C \uD0C8\uCD9C\uAD6C\uC785\uB2C8\uB2E4.","spritePath":"Assets/Materials/image/Frame 102 (3).png"},{"pageID":10005,"label":"\uC6E8\uC774\uBE0C\uC640 \uD074\uB9AC\uC5B4","description":"\uB05D\uB0A0 \uB54C\uAE4C\uC9C0 \uBC29\uC2EC\uD558\uC9C0 \uB9C8\uC2ED\uC2DC\uC624.\n\n\uC801\uB4E4\uC740 \uD55C \uBC88\uC5D0 \uB05D\uB098\uC9C0 \uC54A\uACE0 \uC5EC\uB7EC \uBC88\uC758 '\uC6E8\uC774\uBE0C(Wave)'\uC5D0 \uAC78\uCCD0 \uBAB0\uB824\uC62C \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n\uB9C8\uC9C0\uB9C9 \uC6E8\uC774\uBE0C\uC758 \uC801\uAE4C\uC9C0 \uB0A8\uAE40\uC5C6\uC774 \uCC98\uCE58\uD574\uC57C \uBE44\uB85C\uC18C \uAD73\uAC8C \uB2EB\uD614\uB358 \uBB38\uC774 \uC5F4\uB9BD\uB2C8\uB2E4. \uC2B9\uB9AC\uC758 \uBCF4\uC0C1\uC744 \uCC59\uACA8 \uB2E4\uC74C \uAD6C\uC5ED\uC73C\uB85C \uB098\uC544\uAC00\uC138\uC694.","spritePath":"Assets/Materials/image/Frame 102 (2).png"},{"pageID":10006,"label":"\uB808\uBCA8\uC5C5\uACFC \uC2A4\uD0AC","description":"\uC131\uC7A5\uC740 \uC0DD\uC874\uC744 \uC704\uD55C \uD544\uC218 \uC870\uAC74\uC785\uB2C8\uB2E4.\n\n\uC804\uD22C\uB97C \uD1B5\uD574 \uACBD\uD5D8\uCE58\uB97C \uBAA8\uC544 \uB808\uBCA8\uC744 \uC62C\uB9AC\uC138\uC694. \uB808\uBCA8\uC774 \uC624\uB974\uBA74 \uCE90\uB9AD\uD130\uC758 \uAE30\uBCF8 \uB2A5\uB825\uCE58\uAC00 \uC0C1\uC2B9\uD558\uC5EC \uB354 \uAC15\uD55C \uC801\uACFC \uB9DE\uC124 \uC218 \uC788\uAC8C \uB429\uB2C8\uB2E4.","spritePath":"Assets/Materials/image/Frame 102 (1).png"},{"pageID":10007,"label":"\uC624\uC5FC\uB41C \uD504\uB85C\uC138\uC2A4","description":"\uAC15\uB825\uD55C \uD798\uC5D0\uB294 \uB300\uAC00\uAC00 \uB530\uB985\uB2C8\uB2E4.\n\n\uC774 \uC720\uBB3C\uB4E4\uC740 \uC804\uD22C\uC5D0 \uC720\uC6A9\uD55C \uD798\uC744 \uC8FC\uC9C0\uB9CC, \uACE0\uC720\uD55C '\uC624\uC5FC\uB3C4(\uC7A5\uCC29 \uC911\uB7C9)'\uB97C \uCC28\uC9C0\uD569\uB2C8\uB2E4. \uC790\uC2E0\uC758 \uD55C\uACC4\uCE58\uB97C \uB118\uC9C0 \uC54A\uB3C4\uB85D \uC2E0\uC911\uD558\uAC8C \uC120\uD0DD\uD574\uC57C \uD569\uB2C8\uB2E4.\n\n\uD2B9\uD788 [\uB9AC\uC2A4\uD06C] \uD6A8\uACFC\uAC00 \uBD80\uC5EC\uB41C \uC720\uBB3C\uB4E4 \uC911 \uAC15\uB825\uD55C \uD798\uACFC \uD568\uAED8 \uCE58\uBA85\uC801\uC778 \uC57D\uC810\uC744 \uAC00\uC838\uC62C \uC218 \uC788\uC73C\uB2C8 \uC8FC\uC758\uD558\uC2ED\uC2DC\uC624.","spritePath":"Assets/Materials/image/Frame 102 (8).png"},{"pageID":10008,"label":"\uC815\uD654\uB41C \uD504\uB85C\uC138\uC2A4","description":"\uC624\uC5FC\uC744 \uAC77\uC5B4\uB0B8 \uC21C\uC218\uD55C \uD798\uC785\uB2C8\uB2E4.\n\n\uC815\uD654\uAE30\uB97C \uD1B5\uD574 \uC624\uC5FC\uB41C \uC720\uBB3C\uC911 [\uB9AC\uC2A4\uD06C]\uD6A8\uACFC\uB9CC \uC788\uB294 \uC720\uBB3C\uC744 \uC815\uD654\uD55C \uD615\uD0DC\uC785\uB2C8\uB2E4.\n\n\uAC00\uC7A5 \uD070 \uD2B9\uC9D5\uC740 \uC624\uC5FC\uB3C4 \uC218\uCE58\uAC00 0\uC774\uB77C\uB294 \uC810\uC785\uB2C8\uB2E4. \uC7A5\uCC29 \uC911\uB7C9 \uC81C\uD55C\uC5D0 \uAD6C\uC560\uBC1B\uC9C0 \uC54A\uACE0 \uC790\uC720\uB86D\uAC8C \uCC29\uC6A9\uD560 \uC218 \uC788\uC73C\uBA70, \uC624\uC9C1 \uC774\uB85C\uC6B4 \uD6A8\uACFC\uB9CC\uC744 \uC81C\uACF5\uD558\uC5EC \uB2F9\uC2E0\uC744 \uB354\uC6B1 \uAC15\uD558\uAC8C \uB9CC\uB4ED\uB2C8\uB2E4.","spritePath":"Assets/Materials/image/Frame 102 (9).png"},{"pageID":10009,"label":"\uADFC\uC6D0 \uD504\uB85C\uC138\uC2A4","description":"\uC2EC\uC5F0\uC758 \uAE4A\uC740 \uACF3\uC5D0\uC11C \uBC1C\uACAC\uB41C \uD798\uC785\uB2C8\uB2E4.\n\n\uBCF4\uC2A4\uB098 \uD788\uB4E0 \uC0C1\uC790\uC5D0\uC11C\uB9CC \uC5BB\uC744 \uC218 \uC788\uB294 \uCD5C\uC0C1\uC704 \uB4F1\uAE09\uC758 \uC720\uBB3C\uC785\uB2C8\uB2E4.\n\n\uC555\uB3C4\uC801\uC778 \uC131\uB2A5\uC744 \uC790\uB791\uD558\uC9C0\uB9CC, \uADF8 \uAC15\uB825\uD55C \uD798\uC744 \uC81C\uC5B4\uD558\uAE30 \uC704\uD574 \uD50C\uB808\uC774\uC5B4\uB294 \uCD5C\uB300 3\uAC1C\uAE4C\uC9C0\uB9CC \uC7A5\uCC29\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uCD5C\uACE0\uC758 \uC870\uD569\uC744 \uCC3E\uC544\uBCF4\uC138\uC694.","spritePath":"Assets/Materials/image/Frame 102 (10).png"},{"pageID":10010,"label":"\uC815\uD654\uAE30","description":"\uC704\uD5D8\uC744 \uAE30\uD68C\uB85C \uBC14\uAFB8\uC2ED\uC2DC\uC624.\n\n\uB2F9\uC2E0\uC774 \uAC00\uC9C4 \uC704\uD5D8\uD55C [\uB9AC\uC2A4\uD06C] \uC624\uC5FC\uB41C \uD504\uB85C\uC138\uC2A4\uB97C \uC548\uC804\uD558\uACE0 \uAC15\uB825\uD55C [\uC815\uD654\uB41C \uD504\uB85C\uC138\uC2A4]\uB85C \uBCC0\uD658\uD574 \uC8FC\uB294 \uACE0\uB9C8\uC6B4 \uC7A5\uCE58\uC785\uB2C8\uB2E4.\n\n\uD558\uC9C0\uB9CC \uC0AC\uC6A9 \uD69F\uC218\uC5D0\uB294 \uC81C\uD55C\uC774 \uC788\uC2B5\uB2C8\uB2E4. \uD55C \uC2A4\uD14C\uC774\uC9C0\uC5D0\uC11C \uCD5C\uB300 3\uD68C\uAE4C\uC9C0\uB9CC \uC0AC\uC6A9\uD560 \uC218 \uC788\uC73C\uB2C8, \uAF2D \uD544\uC694\uD55C \uC21C\uAC04\uC5D0 \uC804\uB7B5\uC801\uC73C\uB85C \uC0AC\uC6A9\uD558\uC138\uC694.","spritePath":"Assets/Materials/image/Frame 102 (11).png"},{"pageID":10011,"label":"\uAD50\uD658\uAE30","description":"\uC6B4\uC744 \uC2DC\uD5D8\uD574 \uBCF4\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?\n\n\uD544\uC694 \uC5C6\uB294 \uC720\uBB3C\uC744 \uD22C\uC785\uD558\uC5EC \uC0C8\uB85C\uC6B4 \uC720\uBB3C\uC744 \uC5BB\uC744 \uC218 \uC788\uB294 \uB3C4\uBC15\uC131 \uC7A5\uCE58\uC785\uB2C8\uB2E4. (\uCD5C\uB300 5\uD68C)\n\n- \uAD50\uD658(70%): \uB2E4\uB978 \uC720\uBB3C 1\uAC1C\uB97C \uC5BB\uC2B5\uB2C8\uB2E4.\n- \uB300\uC131\uACF5(20%): \uC6B4\uC774 \uC88B\uAD70\uC694! \uC720\uBB3C 2\uAC1C\uB97C \uC5BB\uC2B5\uB2C8\uB2E4.\n- \uD30C\uAD34(10%): \uC548\uD0C0\uAE5D\uAC8C\uB3C4 \uC720\uBB3C\uC774 \uC18C\uBA78\uD569\uB2C8\uB2E4.","spritePath":"Assets/Materials/image/Frame 102 (14).png"},{"pageID":10012,"label":"\uBCF4\uAE09_\uBCF4\uC0C1\uC0C1\uC790","description":"\uD0D0\uD5D8\uC758 \uC990\uAC70\uC6C0\uC744 \uB193\uCE58\uC9C0 \uB9C8\uC138\uC694.\n\n- \uBCF4\uAE09 \uC0C1\uC790: \uC77C\uBC18 \uC2A4\uD14C\uC774\uC9C0 \uACF3\uACF3\uC5D0 \uC228\uACA8\uC9C4 \uBCF4\uAE09\uD488\uC785\uB2C8\uB2E4.\n- \uBCF4\uC0C1 \uC0C1\uC790: \uCE58\uC5F4\uD55C \uC804\uD22C \uC2A4\uD14C\uC774\uC9C0\uB97C \uB05D\uB0B8 \uB2F9\uC2E0\uC744 \uC704\uD55C \uD655\uC815 \uBCF4\uC0C1\uC785\uB2C8\uB2E4.\n- \uD788\uB4E0 \uC0C1\uC790: \uC5D8\uB9AC\uD2B8 \uBAAC\uC2A4\uD130\uB97C \uCC98\uCE58\uD588\uC744 \uB54C \uC6B4\uC774 \uC88B\uB2E4\uBA74 \uBC1C\uACAC\uD560 \uC218 \uC788\uB294 \uD76C\uADC0\uD55C \uBCF4\uBB3C\uC785\uB2C8\uB2E4.","spritePath":"Assets/Materials/image/Frame 102.png"},{"pageID":10013,"label":"\uC2A4\uD14C\uC774\uC9C0","description":"\uB354 \uAE4A\uC740 \uACF3\uC744 \uD5A5\uD55C \uC5EC\uC815\uC785\uB2C8\uB2E4.\n\n\uC2A4\uD14C\uC774\uC9C0\uB294 \uC5EC\uB7EC \uAC1C\uC758 \uB8F8\uC73C\uB85C \uAD6C\uC131\uB41C \uD070 \uAD6C\uC5ED\uC785\uB2C8\uB2E4. \uC77C\uBC18 \uC2A4\uD14C\uC774\uC9C0\uC640 \uD2B9\uC815 \uB8F8\uC774 \uD655\uC815\uC801\uC73C\uB85C \uB098\uC624\uB294 \uC2A4\uD14C\uC774\uC9C0 \uB4F1\uC774 \uC788\uC73C\uBA70, \uAC01\uAE30 \uB2E4\uB978 \uACBD\uD5D8\uC744 \uC81C\uACF5\uD569\uB2C8\uB2E4.\n\n\uB9C8\uC9C0\uB9C9 \uB8F8\uAE4C\uC9C0 \uB3C4\uB2EC\uD558\uC5EC \uBAA9\uD45C\uB97C \uB2EC\uC131\uD558\uACE0 \uB2E4\uC74C \uC2A4\uD14C\uC774\uC9C0\uB85C \uB098\uC544\uAC00\uC2ED\uC2DC\uC624.","spritePath":"Assets/Materials/image/Frame 102 (4).png"},{"pageID":10014,"label":"\uB8F8","description":"\uC804\uD22C\uC640 \uC120\uD0DD\uC774 \uAE30\uB2E4\uB9AC\uB294 \uACF5\uAC04\uC785\uB2C8\uB2E4.\n\n\uAC01 \uB8F8\uC740 \uB3C5\uB9BD\uB41C \uACF5\uAC04\uC73C\uB85C, \uBAAC\uC2A4\uD130\uAC00 \uB4F1\uC7A5\uD558\uB294 \uC804\uD22C \uB8F8\uC774\uB098 \uC815\uD654\uAE30 \uB4F1\uC774 \uC788\uB294 \uC774\uBCA4\uD2B8 \uB8F8\uC73C\uB85C \uAD6C\uC131\uB429\uB2C8\uB2E4.\n\n\uB8F8\uC5D0 \uC9C4\uC785\uD558\uBA74 \uBB38\uC774 \uC7A0\uAE38 \uC218 \uC788\uC73C\uBA70, \uC8FC\uC5B4\uC9C4 \uC0C1\uD669\uC744 \uD574\uACB0\uD574\uC57C\uB9CC \uAD73\uAC8C \uB2EB\uD78C \uBB38\uC744 \uC5F4\uACE0 \uC774\uB3D9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.","spritePath":"Assets/Materials/image/Frame 102 (4).png"},{"pageID":10015,"label":"\uC544\uC774\uD15C \uD30C\uBC0D","description":"\uC804\uB9AC\uD488\uC740 \uC2B9\uB9AC\uC790\uC758 \uD2B9\uAD8C\uC785\uB2C8\uB2E4.\n\n\uC801\uC744 \uCC98\uCE58\uD558\uAC70\uB098 \uC0C1\uC790\uB97C \uC5F4\uC5B4\uC11C \uD655\uB960\uC801\uC73C\uB85C '\uC624\uC5FC\uB41C \uD504\uB85C\uC138\uC2A4\u2019, \uAC74\uC804\uC9C0(\uCCB4\uB825\uD68C\uBCF5)\uC640 \uACBD\uD5D8\uCE58\uB97C \uD68D\uB4DD\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n\uB2E4\uC591\uD55C \uC720\uBB3C\uC744 \uC218\uC9D1\uD558\uACE0 \uC870\uD569\uD558\uC5EC \uB2F9\uC2E0\uB9CC\uC758 \uC804\uD22C \uC2A4\uD0C0\uC77C\uC744 \uC644\uC131\uD558\uC2ED\uC2DC\uC624. \uD558\uC9C0\uB9CC \uC720\uBB3C\uC758 \uC624\uC5FC\uB3C4(\uC911\uB7C9)\uB97C \uD56D\uC0C1 \uACE0\uB824\uD574\uC57C \uD569\uB2C8\uB2E4.","spritePath":"Assets/Materials/image/Frame 102 (12).png"}]
